{
  "name": "printdock",
  "version": "0.0.1",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "description": "PrintDock by Nexkit: a React Native Android bridge from raw LAN TCP jobs to compatible Bluetooth Classic or USB OTG bulk receipt printers. Pre-production; iOS experimental.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nathanpixodeo/printdock.git"
  },
  "homepage": "https://github.com/nathanpixodeo/printdock#readme",
  "bugs": {
    "url": "https://github.com/nathanpixodeo/printdock/issues"
  },
  "keywords": [
    "react-native",
    "typescript",
    "android",
    "bluetooth",
    "usb-otg",
    "thermal-printer",
    "escpos",
    "tcp-server",
    "print-server",
    "point-of-sale",
    "receipt-printer",
    "foreground-service",
    "lan-printing",
    "mobile-app"
  ],
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest",
    "test:coverage": "jest --collectCoverage --coverageDirectory=\"./coverage\"",
    "test:report": "jest --collectCoverage --coverageDirectory=\"./coverage\" --ci --reporters=default --reporters=jest-junit",
    "lint:rules": "eslint . --cache",
    "lint:format": "prettier --check \"{src,__mocks__}/**/*.{js,json,md,ts,tsx,yml,yaml}\"",
    "lint:types": "tsc --noEmit",
    "lint": "yarn lint:rules && yarn lint:format && yarn lint:types",
    "lint:fix": "yarn lint:rules --fix && yarn lint:format --write && yarn lint:types",
    "pod-install": "cd ios && bundle exec pod install"
  },
  "dependencies": {
    "@react-native-masked-view/masked-view": "^0.3.1",
    "@react-native-picker/picker": "^2.10.2",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/stack": "^6.4.1",
    "@tanstack/react-query": "^5.59.8",
    "buffer": "^6.0.3",
    "i18next": "^23.15.2",
    "react": "18.3.1",
    "react-error-boundary": "^4.0.13",
    "react-i18next": "^15.0.2",
    "react-native": "0.75.4",
    "react-native-background-actions": "4.0.1",
    "react-native-gesture-handler": "^2.20.0",
    "react-native-mmkv": "^2.12.2",
    "react-native-network-info": "^5.2.1",
    "react-native-permissions": "^5.1.0",
    "react-native-reanimated": "^3.15.4",
    "react-native-safe-area-context": "^4.11.0",
    "react-native-screens": "3.34.0",
    "react-native-svg": "^15.7.1",
    "react-native-tcp-socket": "^6.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "patch-package": "8.0.0",
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.3.1",
    "@react-native/babel-preset": "0.75.3",
    "@react-native/metro-config": "0.75.3",
    "@react-native/typescript-config": "0.75.3",
    "@testing-library/jest-native": "^5.4.2",
    "@testing-library/react-native": "^12.1.2",
    "@types/jest": "^29.4.0",
    "@types/node": "^18.14.1",
    "@types/react": "^18.2.6",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.6.3",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^9.12.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.8.3",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc-70fb1363-20241010",
    "eslint-plugin-perfectionist": "5.12.1",
    "eslint-plugin-unicorn": "^56.0.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "jest": "^29.7.0",
    "jest-junit": "16.0.0",
    "prettier": "^3.3.3",
    "react-native-svg-transformer": "^1.5.0",
    "react-test-renderer": "18.3.1",
    "reactotron-react-native": "5.3.1",
    "reactotron-core-client": "2.10.0",
    "reactotron-react-native-mmkv": "^0.2.7",
    "typescript": "5.6.3",
    "typescript-eslint": "8.70.1"
  },
  "engines": {
    "node": ">=22.23.3 <23"
  }
}
