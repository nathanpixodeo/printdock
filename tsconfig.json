{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    "module": "esnext",
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "__mocks__/**/*",
    "./src/**/*",
    "index.d.ts",
    "index.js",
    "jest.setup.js",
    "jest.config.js",
    "babel.config.js",
    "eslint.config.mjs",
    "metro.config.js",
    ".prettierrc.js"
  ],
  "exclude": ["node_modules", "android", "ios"]
}
